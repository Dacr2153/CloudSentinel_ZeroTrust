# FILE: cloudsentinel-zero-trust/.env.example
# CloudSentinel Zero-Trust — Environment Variables
# Copy to .env and customize for your deployment.
# NOTE: Never commit .env to version control.

# ── Core Configuration ──
CLOUDSENTINEL_ENVIRONMENT=dev
CLOUDSENTINEL_AWS_REGION=us-east-1
CLOUDSENTINEL_LOG_LEVEL=INFO

# ── SSM Parameter Store ──
CLOUDSENTINEL_SSM_PREFIX=/cloudsentinel/dev

# ── OpenSearch ──
CLOUDSENTINEL_OPENSEARCH_ENDPOINT=https://<EC2_PRIVATE_IP>:9200
CLOUDSENTINEL_OPENSEARCH_INDEX_PREFIX=cloudsentinel
CLOUDSENTINEL_OPENSEARCH_BATCH_SIZE=500

# ── SNS Alerting ──
CLOUDSENTINEL_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<ACCOUNT_ID>:cloudsentinel-alerts

# ── ML Model ──
CLOUDSENTINEL_MODEL_BUCKET=cloudsentinel-models-<ACCOUNT_ID>
CLOUDSENTINEL_MODEL_KEY=models/isolation_forest/model.joblib
CLOUDSENTINEL_ANOMALY_THRESHOLD=65

# ── Alert Configuration ──
CLOUDSENTINEL_ALERT_COOLDOWN_MINUTES=15
